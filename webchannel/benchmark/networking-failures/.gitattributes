# Machine-generated evidence remains available without dominating PR review.
*.log linguist-generated=true
*.jsonl linguist-generated=true
*.json linguist-generated=true
*.csv linguist-generated=true
*.patch linguist-generated=true
2026-11-12/automatic-native/tool-sources/** linguist-generated=true
2026-11-13/**/tool-sources/** linguist-generated=true
# CSV uses standard CRLF records; patch context preserves significant spaces.
*.csv whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
*.patch -whitespace
