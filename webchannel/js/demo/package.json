{
  "name": "webchannel-message-generator-demo",
  "version": "1.0.0",
  "description": "TypeScript Web Message Generator Demo for WebChannel",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:browser": "node browser-smoke.mjs",
    "deps:check": "node ../scripts/check-dependency-age.mjs demo",
    "deps:install": "npm run deps:check && npm ci"
  },
  "devDependencies": {
    "vite": "8.3.8"
  },
  "private": true,
  "type": "module",
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=11.17.0",
      "onFail": "error"
    }
  },
  "allowScripts": {
    "fsevents@2.3.3": false
  }
}
